# 이 파일을 복사해서 이름을 .env 로 바꾼 뒤, 발급받은 키를 = 뒤에 붙여 넣으세요.
# (.env 파일은 git에 올라가지 않습니다.)

# 카카오 개발자(https://developers.kakao.com) > 내 애플리케이션 > 앱 키 > JavaScript 키
# JavaScript SDK 도메인(옛 화면: 플랫폼 > Web)에 http://localhost:5174 를 등록하고,
# 제품 설정 > 카카오맵 을 ON 으로 켜야 지도가 뜹니다.
# 비워 두면 OpenStreetMap 임시 지도로 표시됩니다.
VITE_KAKAO_JS_KEY=

# ----- 아래 두 개는 데이터를 새로 받을 때(npm run fetch-…) 씁니다. 화면만 띄울 때는 없어도 됩니다 -----

# 공공데이터포털(https://www.data.go.kr) 에서 아래 API 를 "활용신청" 한 뒤, 마이페이지의 인증키
#   - 국토교통부_연립다세대 전월세 실거래가 자료
#   - 국토교통부_오피스텔 전월세 실거래가 자료
#   - 한국토지주택공사_분양임대공고문 조회 서비스 (npm run fetch-lh)
DATA_GO_KR_KEY=

# 카카오 개발자 > 내 애플리케이션 > 앱 키 > REST API 키 (주소를 지도 좌표로 바꾸는 데 사용)
KAKAO_REST_KEY=
